<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:padding="8dp"
    android:maxHeight="560dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="≡  Hi-Lo    (trascina)"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="RC:0"
                android:paddingEnd="12dp"/>

            <TextView
                android:id="@+id/tvTc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="TC:0.0"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdvantage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="Banco +0,5% a +1,5%"
            android:textColor="@color/red"
            android:paddingTop="2dp"/>

        <TextView
            android:id="@+id/tvBet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="Puntata: 1u"
            android:textColor="@color/yellow"
            android:paddingTop="2dp"/>

        <TextView
            android:id="@+id/tvAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="#334155"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:text="—"/>

        <TextView
            android:id="@+id/tvActionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="2dp"
            android:text=""/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TU"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="6dp"/>

        <GridLayout
            android:id="@+id/padPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="3"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BANCO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingTop="4dp"/>

        <GridLayout
            android:id="@+id/padDealer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="3"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:background="@drawable/bg_btn_gray"
                android:textColor="#FFFFFF"
                android:text="Undo"/>

            <Button
                android:id="@+id/btnNextHand"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:background="@drawable/bg_btn_gray"
                android:textColor="#FFFFFF"
                android:text="Mano"/>

            <Button
                android:id="@+id/btnClose"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:background="@drawable/bg_btn_red"
                android:textColor="#FFFFFF"
                android:text="X"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Risultato mano"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnWin"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_green"
                android:textColor="#FFFFFF"
                android:text="WIN"/>

            <Button
                android:id="@+id/btnBj"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_gold"
                android:textColor="#FFFFFF"
                android:text="BJ"/>

            <Button
                android:id="@+id/btnPush"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_gray"
                android:textColor="#FFFFFF"
                android:text="PUSH"/>

            <Button
                android:id="@+id/btnLose"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_red"
                android:textColor="#FFFFFF"
                android:text="LOSE"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="1dp"
            android:text="Mani: 0   Netto: 0.0u   EV/mano: 0.000u"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:background="@drawable/bg_btn_gray"
                android:textColor="#FFFFFF"
                android:text="Esporta CSV"/>

            <Button
                android:id="@+id/btnResetAll"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="10sp"
                android:background="@drawable/bg_btn_red"
                android:textColor="#FFFFFF"
                android:text="Reset tutto"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
